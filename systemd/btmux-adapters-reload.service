[Unit]
Description=btmux — application d'une nouvelle affectation des rôles puis redémarrage de btmuxd (#23 D3)
Documentation=https://github.com/CCoupel/Blue-Multiplex
# Déclenchée uniquement par btmux-adapters.path (aucune section d'installation).
After=bluetooth.service btmux-adapters.service
ConditionPathExists=/etc/btmux/config.yaml

[Service]
Type=oneshot
# Simple redémarrage de btmuxd : arrêt propre (SIGTERM, code 0 ; ExecStopPost referme appairage/découverte) puis relance,
# dont l'ExecStartPre (root) applique l'identité des contrôleurs selon la nouvelle liste effective. L'identité n'est donc
# appliquée qu'une fois, et le SIGTERM arrive en < 1 s après l'écriture de l'état : pas de course avec le repli code 4 (30 s),
# donc pas de double redémarrage. --no-block : ne pas attendre la fin du cycle.
ExecStart=/usr/bin/systemctl restart --no-block btmuxd.service
TimeoutStartSec=30
