# Variables specifiques a QUALIF — voir agents/deploy.md section "Fichiers d'Environnement".
# Copier en qualif.env (jamais commite, gitignore) et completer les valeurs.
# Lues par deployer (deploy.qualif.md), scripts/deploy.sh et commands.smoke.
SSH_KEY_PATH=
DEPLOY_HOST=ubuntu@btmux-qualif.local
# Utilisateur de service de btmuxd (optionnel ; defaut = partie user de DEPLOY_HOST)
BTMUX_USER=
