  "workshop": {
    "users": "L'auteur (usage perso, un Pi qualif + un Pi prod) ; projet open source public pour d'autres bricoleurs",
    "deadline": "Aucune — au rythme disponible, milestones decoupes par valeur livree",
    "risks": [
      "Double role HFP (HF sur hci-src + AG sur hci-hp) sur un meme Pi avec le backend natif PipeWire — risque de devoir passer par oFono pour le role HF",
      "Latence et qualite audio sur double saut Bluetooth + resampling PipeWire (objectif < 300 ms A2DP)",
      "Relais AVRCP et controle d'appel (ATA/AT+CHUP) entre deux piles distinctes, peu documente"
    ],
    "regulatory": "Aucune — LAN perso, jeton API statique, appairage ferme par defaut"
  }
