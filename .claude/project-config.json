{
  "name": "Blue-Multiplex",
  "team_name": "blue-multiplex-team",
  "org": "CCoupel",
  "project": "Blue-Multiplex",
  "description": "Multiplexeur Bluetooth audio sur Raspberry Pi (btmux) : les PC et telephones voient le Pi comme un casque (A2DP sink + HFP HF), les casques le voient comme une source (A2DP source + HFP AG) ; bascule de source purement logicielle via PipeWire, flux bidirectionnel (micro), aucun logiciel cote sources.",
  "version": "0.1.0",
  "initialized_at": "2026-10-13T10:30:00+02:00",
  "initialized_from": "workshop",
  "template_version": {
    "tag": "v3.23.3",
    "commit": "d2a1e1aa0345db19c3b21d43c41e9f2ade5203ec"
  },
  "src_dir": "src",
  "version_file": "pyproject.toml",
  "stack": {
    "backend": {
      "language": "python",
      "framework": "asyncio",
      "runtime": ">=3.12",
      "notes": "dbus-fast (BlueZ), PipeWire via pw-dump/pw-link/pw-metadata ou script Lua WirePlumber (choix phase 0), API HTTP FastAPI ou aiohttp, CLI btmuxctl"
    },
    "frontend": {
      "language": "javascript",
      "framework": null,
      "notes": "Web UI minimale, HTML/CSS/JS vanilla servie par l'API — prevue plus tard, pas en v1"
    },
    "mobile": null,
    "firmware": null,
    "plugin": null,
    "database": {
      "primary": null,
      "orm": null,
      "notes": "Configuration YAML /etc/btmux/config.yaml, aucune base de donnees"
    },
    "target": {
      "hardware": "Raspberry Pi 4/5, 2 dongles USB BT 5.x (RTL8761B)",
      "os": "Raspberry Pi OS / Debian Trixie 64 bits",
      "system": "BlueZ, PipeWire >= 1.2, WirePlumber 0.5, systemd"
    }
  },
  "infrastructure": {
    "cicd": "github-actions",
    "environments": [
      {
        "name": "QUALIF",
        "order": 1,
        "publish": {
          "mode": "promote",
          "target": "build/qualif_v{X.Y.Z}/"
        },
        "deploy": {
          "mechanism": "vps",
          "target": "ubuntu@btmux-qualif.local:/opt/btmux",
          "notes": "Pi de qualification — scripts/deploy.sh : scp de la wheel, uv pip install, unites systemd, restart"
        }
      },
      {
        "name": "PROD",
        "order": 2,
        "publish": {
          "mode": "rebuild-ci",
          "trigger": "git-tag",
          "pipeline": ".github/workflows/release.yml",
          "artifact": "paquet .deb (btmux_X.Y.Z_all.deb) attache a la GitHub Release"
        },
        "deploy": {
          "mechanism": "vps",
          "target": "ubuntu@btmux.local:/opt/btmux",
          "notes": "Pi de production — telechargement du .deb de la release, scp, dpkg -i, restart"
        }
      }
    ]
  },
  "testing": {
    "backend": [
      "pytest"
    ],
    "frontend": [],
    "e2e": [],
    "components": {
      "bluez": [
        "src/btmux/bluez/**"
      ],
      "pipewire": [
        "src/btmux/pipewire/**"
      ],
      "routing": [
        "src/btmux/routing/**"
      ],
      "api": [
        "src/btmux/api/**"
      ],
      "cli": [
        "src/btmux/cli/**"
      ],
      "config": [
        "src/btmux/config/**"
      ],
      "packaging": [
        "debian/**",
        "systemd/**",
        "scripts/**"
      ]
    },
    "regression_at_qa": "gated",
    "full_regression_at": "qualif",
    "coverage_min": 70,
    "lot_max_tests": 50,
    "perf": {
      "a2dp_latency_ms_max": 300,
      "source_switch_ms_max": 1000,
      "a2dp_to_hfp_switch_ms_max": 2000
    }
  },
  "security": {
    "concerns": [
      "api-token",
      "pairing-closed-by-default",
      "dependencies"
    ]
  },
  "commands": {
    "build": "uv build",
    "test": "uv run pytest",
    "lint": "uv run ruff check . && uv run ruff format --check .",
    "audit": "uv run pip-audit",
    "ci": "scripts/ci.sh",
    "typecheck": "uv run mypy src",
    "coverage": "uv run pytest --cov=btmux --cov-report=term-missing",
    "test_fast": "uv run pytest -m \"not slow\"",
    "test_targeted": "uv run pytest {TARGETS}",
    "smoke": "bash -c 'set -a; . <(tr -d \"\\r\" < .claude/agents/environments/qualif.env); set +a; ssh -i \"$SSH_KEY_PATH\" -o BatchMode=yes -- \"$DEPLOY_HOST\" \"systemctl is-active btmuxd && /opt/btmux/bin/btmuxd --version && /opt/btmux/bin/btmuxd --config /etc/btmux/config.yaml --check-config\"'"
  },
  "docs": {
    "mockup_dir": "docs/mockup",
    "cadrage": "docs/cadrage.md",
    "marketing_cadrage": "docs/marketing-cadrage.md"
  },
  "marketing": {
    "site": "auto",
    "cadrage": "docs/marketing-cadrage.md",
    "url": "https://ccoupel.github.io/Blue-Multiplex/",
    "languages": [
      "fr",
      "en"
    ]
  },
