{
  "name": "Blue-Multiplex",
  "team_name": "blue-multiplex-team",
  "org": "CCoupel",
  "project": "Blue-Multiplex",
  "description": "Multiplexeur Bluetooth audio sur Raspberry Pi (btmux) : les PC et telephones voient le Pi comme un casque (A2DP sink + HFP HF), les casques le voient comme une source (A2DP source + HFP AG) ; bascule de source purement logicielle via PipeWire, flux bidirectionnel (micro), aucun logiciel cote sources.",
  "version": "0.1.0",
  "initialized_at": "2026-10-13T10:30:00+02:00",
  "initialized_from": "workshop",
  "template_version": {
    "tag": "v3.27.0",
    "commit": "2ca467df6ab3786c4e6949c1bce43f25c869a5bf"
  },
  "src_dir": "src",
  "version_file": "pyproject.toml",
  "stack": {
    "backend": {
      "language": "python",
      "framework": "asyncio",
      "runtime": ">=3.12",
      "notes": "dbus-fast (BlueZ), PipeWire via pw-dump -m + session pw-cli persistante (Lua WirePlumber non retenu, spike #7), API HTTP aiohttp + SSE, CLI btmuxctl"
    },
    "frontend": {
      "language": "javascript",
      "framework": null,
      "notes": "Web UI minimale, HTML/CSS/JS vanilla servie par l'API — Web UI d'appairages livree en v0.2.0 (#16)"
    },
    "mobile": null,
    "firmware": null,
    "plugin": null,
    "database": {
      "primary": null,
      "orm": null,
      "notes": "Configuration YAML /etc/btmux/config.yaml, aucune base de donnees"
    },
    "target": {
      "hardware": "Raspberry Pi (qualif : Pi 3 B), 2 dongles USB BT 5.x TP-Link UB500 (RTL8761BU)",
      "os": "Ubuntu Server 26.04 LTS arm64",
      "system": "BlueZ, PipeWire >= 1.2, WirePlumber 0.5, systemd"
    }
  },
  "infrastructure": {
    "cicd": "github-actions",
    "environments": [
      {
        "name": "QUALIF",
        "order": 1,
        "publish": {
          "mode": "promote",
          "target": "build/qualif_v{X.Y.Z}/"
        },
        "deploy": {
          "mechanism": "vps",
          "target": "ubuntu@pi-qualif.local:/opt/btmux",
          "notes": "Pi de qualification — scripts/deploy.sh : scp de la wheel, uv pip install, unites systemd, restart"
        },
        "access": {
          "method": "ssh",
          "host_env": "DEPLOY_HOST",
          "port": 22,
          "runtime": "systemd",
          "target_dir": "/opt/btmux",
          "privilege": "sudo -n",
          "credentials_env": [
            "SSH_KEY_PATH",
            "DEPLOY_HOST",
            "FORBIDDEN_HOSTS"
          ],
          "verified": {
            "status": "ok",
            "at": "2026-10-24T15:06:28Z",
            "checks": [
              "forbidden-hosts",
              "ssh",
              "hostname=pi-qualif",
              "sudo-n",
              "python3",
              "systemd",
              "target-dir"
            ]
          }
        }
      },
      {
        "name": "PROD",
        "order": 2,
        "publish": {
          "mode": "rebuild-ci",
          "trigger": "git-tag",
          "pipeline": ".github/workflows/release.yml",
          "artifact": "paquet .deb (btmux_X.Y.Z_all.deb) attache a la GitHub Release"
        },
        "deploy": {
          "mechanism": "vps",
          "target": "ubuntu@btmux.local:/opt/btmux",
          "notes": "Pi de production — telechargement du .deb de la release, scp, dpkg -i, restart"
        },
        "access": {
          "method": "ssh",
          "host_env": "DEPLOY_HOST",
          "port": 22,
          "runtime": "systemd",
          "target_dir": "/opt/btmux",
          "credentials_env": [
            "SSH_KEY_PATH",
            "DEPLOY_HOST"
          ],
          "verified": {
            "status": "skipped",
            "at": "2026-10-24T15:06:28Z",
            "checks": [
              "repo-push"
            ],
            "note": "droit de push du tag verifie (rebuild-ci) ; Pi de production pas encore disponible, sondes SSH a rejouer"
          }
        }
      }
    ]
  },
  "testing": {
    "backend": [
      "pytest"
    ],
    "frontend": [],
    "e2e": [],
    "components": {
      "bluez": [
        "src/btmux/bluez/**"
      ],
      "pipewire": [
        "src/btmux/pipewire/**"
      ],
      "routing": [
        "src/btmux/routing/**"
      ],
      "api": [
        "src/btmux/api/**"
      ],
      "cli": [
        "src/btmux/cli/**"
      ],
      "config": [
        "src/btmux/config/**"
      ],
      "packaging": [
        "debian/**",
        "systemd/**",
        "scripts/**"
      ]
    },
    "regression_at_qa": "gated",
    "full_regression_at": "qualif",
    "coverage_min": 70,
    "lot_max_tests": 50,
    "perf": {
      "a2dp_latency_ms_max": 300,
      "source_switch_ms_max": 1000,
      "a2dp_to_hfp_switch_ms_max": 2000
    }
  },
  "security": {
    "concerns": [
      "api-token",
      "pairing-closed-by-default",
      "dependencies"
    ]
  },
  "commands": {
    "build": "uv build",
    "test": "uv run pytest",
    "lint": "uv run ruff check . && uv run ruff format --check .",
    "audit": "uv run pip-audit",
    "ci": "scripts/ci.sh",
    "typecheck": "uv run mypy src",
    "coverage": "uv run pytest --cov=btmux --cov-report=term-missing",
    "test_fast": "uv run pytest -m \"not slow\"",
    "test_targeted": "uv run pytest {TARGETS}",
    "smoke": "bash -c 'set -a; . <(tr -d \"\\r\" < .claude/agents/environments/qualif.env); set +a; ssh -i \"$SSH_KEY_PATH\" -o BatchMode=yes -- \"$DEPLOY_HOST\" \"systemctl is-active btmuxd && curl -fsS http://127.0.0.1:8088/api/health && echo && c=\\$(curl -s -o /dev/null -w %{http_code} http://127.0.0.1:8088/api/state) && test \\\"\\$c\\\" = 401 && curl -fsS -o /dev/null -H \\\"Authorization: Bearer \\$(sudo cat /etc/btmux/token)\\\" http://127.0.0.1:8088/api/state && echo smoke_ok\"'",
    "smoke_note": "LOT-1 v0.2.0 : is-active btmuxd + btmuxd --version + --check-config (via ssh, qualif.env). Apres LOT-2 (#21, T2.3) : remplacer commands.smoke par commands.smoke_api (GET /api/health public, /api/state 401 sans jeton et 200 avec le jeton lu sur le Pi) — voir .claude/agents/environments/deploy.qualif.md",
    "smoke_api": "bash -c 'set -a; . <(tr -d \"\\r\" < .claude/agents/environments/qualif.env); set +a; ssh -i \"$SSH_KEY_PATH\" -o BatchMode=yes -- \"$DEPLOY_HOST\" \"set -e; systemctl is-active btmuxd; curl -fsS http://127.0.0.1:8088/api/health; test \\$(curl -s -o /dev/null -w %{http_code} http://127.0.0.1:8088/api/state) = 401; curl -fsS -o /dev/null -H \\\"Authorization: Bearer \\$(sudo cat /etc/btmux/token)\\\" http://127.0.0.1:8088/api/state\"'"
  },
  "docs": {
    "mockup_dir": "docs/mockup",
    "cadrage": "docs/cadrage.md",
    "marketing_cadrage": "docs/marketing-cadrage.md"
  },
